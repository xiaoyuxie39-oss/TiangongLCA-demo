# instructor-only material (paper PDF, scans, raw dumps) – never committed
local/

# raw snapshot JSON is large; the gzipped copies are committed instead
data/snapshot/*.json
!data/snapshot/meta.json
data/snapshot_build.log

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# node
node_modules/
classroom/.local/
classroom/.dev.vars
classroom/.wrangler/
classroom/dist/

# os / editors
.DS_Store
.vscode/
.idea/
